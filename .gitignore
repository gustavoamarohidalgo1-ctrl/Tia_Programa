# Publicar únicamente los archivos de Servicio Exclusivo indicados aquí.
# Los archivos nuevos requieren inclusión explícita para evitar compartir datos del negocio.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LEEME.txt
!/agencia.py
!/logo.png
!/icono.png
!/icono.ico
!/icono.icns
!/Iniciar.bat
!/Crear_EXE.bat
!/Crear_App_Mac.command
!/test_*.py
!/instaladores/
/instaladores/*
!/instaladores/Agencia-de-Empleos-Windows-x64.exe
!/instaladores/Agencia-de-Empleos-Mac-arm64.dmg
!/instaladores/SHA256SUMS.txt
!/instaladores/construccion/
/instaladores/construccion/*
!/instaladores/construccion/crear_instalador_windows.sh
!/instaladores/construccion/crear_instalador_mac.sh
!/instaladores/construccion/archivos_en_uso.nsh
!/instaladores/construccion/instalador.nsi
!/instaladores/construccion/minimo_macos.py
!/instaladores/construccion/iniciar.pyw
!/instaladores/construccion/version_windows.txt

# Exclusiones explícitas: datos privados, archivos generados y el proyecto separado.
PrimaXiaomara/
analisis/
respaldo_*/
respaldos/
contratos/
tmp/
output/
__pycache__/
*.py[cod]
*.db
*.db-*
*.sqlite
*.sqlite3
*.log
*.app/
*.pdf
*.csv
*.xlsx
configuracion.json
borradores.json
.DS_Store
.env
.env.*
*.pem
*.key
